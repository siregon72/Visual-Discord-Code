{
  "name": "visual-discord-code",
  "productName": "Visual Discord Code",
  "version": "0.3.6",
  "description": "A standalone editor-style window for Discord Web",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "electron tests/live-desktop.cjs",
    "dist": "npm run validate && electron-builder --win zip --x64",
    "pack": "npm run validate && electron-builder --win --dir --x64",
    "check": "node scripts/check.cjs",
    "validate": "npm run check && npm test"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "jsdom": "30.1.3"
  },
  "build": {
    "appId": "local.visualdiscordcode.desktop",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "navigation.js",
      "send-message.js",
      "discord-adapter.js",
      "live.html",
      "live.js",
      "README.md",
      "NOTICE.md",
      "assets/**",
      "styles.css",
      "src/**"
    ],
    "win": {
      "target": "zip",
      "icon": "assets/app-icon.ico",
      "signExecutable": false,
      "signAndEditExecutable": false,
      "artifactName": "Visual-Discord-Code-${version}-Windows-x64.zip"
    },
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "disableAsarIntegrity": true
  },
  "engines": {
    "node": ">=24"
  }
}
